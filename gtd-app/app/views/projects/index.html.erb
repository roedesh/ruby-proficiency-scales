<p style="color: green"><%= notice %></p>

<% content_for :title, "Projects" %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Overview", root_path %></li>
    <li class="breadcrumb-item active" aria-current="page">Projects</li>
  </ol>
</nav>

<h1>Projects</h1>

<%= link_to "New project", new_project_path, class: "btn btn-light" %>

<div class="projects-grid">
  <% @projects.each do |project| %>
  <div class="col-4">
    <div class="card" style="width: 18rem;">
      <div class="card-body">
        <h5 class="card-title"><%= project.name %></h5>
        <p class="card-text"><%= project.description %></p>
        <p class="card-text">Status: <%= project.status %></p>
        <%= link_to "Show this project", project, class: "btn btn-primary" %>
      </div>
    </div>
  </div>
  <% end %>
</div>


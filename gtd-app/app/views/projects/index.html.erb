<% content_for :title, t('projects.index.projects') %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('breadcrumbs.overview'), root_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= t('projects.index.projects') %></li>
  </ol>
</nav>

<h1><%= t('projects.index.projects') %></h1>

<%= link_to t('projects.index.new_project'), new_project_path, class: "btn btn-primary" %>

<div class="mt-4">
  <% @projects.each do |project| %>
  <div class="col-4">
    <div class="card" style="width: 18rem;">
      <div class="card-body">
        <h5 class="card-title"><%= link_to project.name, project %></h5>
        <p class="card-text"><%= project.description %></p>
        <p class="card-text"><%= t('projects.index.items') %>: <%= project.items.length %></p>
        <p class="card-text"><%= t('activerecord.attributes.project.status') %>: <%= project.status %></p>
      </div>
    </div>
  </div>
  <% end %>
</div>


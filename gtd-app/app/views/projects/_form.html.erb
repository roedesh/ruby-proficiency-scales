<%= form_with(model: project) do |form| %>
  <% if project.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <p><%= pluralize(project.errors.count, "error") %> prohibited this project from being saved:</p>
      <ul>
        <% project.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label", style: "display: block" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label", style: "display: block" %>
    <%= form.textarea :description, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :status, class: "form-label", style: "display: block" %>
    <%= form.select :status, Project::STATUSSES, {}, { :class => 'form-select' } %>
  </div>

  <div class="mb-3">
    <%= form.label :completed_at, style: "display: block" %>
    <%= form.datetime_field :completed_at, class: "form-control" %>
  </div>

  <div>
    <%= form.submit "Submit", class: "btn btn-primary" %>
  </div>
<% end %>

<div id="<%= dom_id project %>">
  <div>
    <strong>User:</strong>
    <%= project.user_id %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= project.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= project.description %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= project.status %>
  </div>

  <div>
    <strong>Completed at:</strong>
    <%= project.completed_at %>
  </div>

</div>

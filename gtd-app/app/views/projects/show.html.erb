<p style="color: green"><%= notice %></p>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('breadcrumbs.overview'), root_path %></li>
    <li class="breadcrumb-item"><%= link_to t('projects.index.projects'), projects_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= @project.name %></li>
  </ol>
</nav>

<%= render @project %>

<div class="mt-3 mb-3">
  <%= link_to t('projects.show.edit_this_project'), edit_project_path(@project), class: "btn btn-primary" %>
</div>

<div>
  <%= button_to t('projects.show.delete_this_project'), @project, method: :delete, class: "btn btn-danger" %>
</div>

<%= form_with(model: tag) do |form| %>
  <% if tag.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <p><%= t('tags.form.errors_prohibited', count: tag.errors.count) %></p>
      <ul>
        <% tag.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label", style: "display: block" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div>
    <%= form.submit t('shared.submit'), class: "btn btn-primary" %>
  </div>
<% end %>

<div id="<%= dom_id context %>">
  <h1>@<%= @context.name %></h1>

  <div class="card">
    <div class="card-body">
      <h5 class="card-title"><%= t('items.index.items') %></h5>
      <table class="table">
        <thead>
          <tr>
            <th scope="col"><%= t('items.index.title') %></td>
            <th scope="col"><%= t('shared.description') %></td>
            <th scope="col"><%= t('shared.status') %></td>
            <th scope="col"><%= t('shared.completed_at') %></td>
            <th scope="col"><%= t('shared.actions') %></td>
          </tr>
        </thead>
        <tbody>
          <% if @context.items.count > 0 %>
            <% @context.items.each do |item| %>
              <tr>
                <td scope="row"><%= item.title %></td>
                <td><%= item.description.presence || "-" %></td>
                <td><%= item.status %></td>
                <td><%= item.completed_at.presence || "-" %></td>
                <td><%= link_to t('shared.show'), item %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5"><%= t('shared.no_items_yet') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<p style="color: green"><%= notice %></p>

<% content_for :title, "Contexts" %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Overview", root_path %></li>
    <li class="breadcrumb-item active" aria-current="page">Contexts</li>
  </ol>
</nav>

<h1>Contexts</h1>

<%= link_to "New context", new_context_path, class: "btn btn-primary" %>

<div class="mt-4">
  <% @contexts.each do |context| %>
  <div class="col-4">
    <div class="card" style="width: 18rem;">
      <div class="card-body">
        <h5 class="card-title"><%= link_to "@" + context.name, context %></h5>
        <p class="card-text">Items: <%= context.items.length %></p>
      </div>
    </div>
  </div>
  <% end %>
</div>



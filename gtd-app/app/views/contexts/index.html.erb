<p style="color: green"><%= notice %></p>

<% content_for :title, t('contexts.index.contexts') %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('breadcrumbs.overview'), root_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= t('contexts.index.contexts') %></li>
  </ol>
</nav>

<h1><%= t('contexts.index.contexts') %></h1>

<%= link_to t('contexts.index.new_context'), new_context_path, class: "btn btn-primary" %>

<div class="mt-4">
  <% @contexts.each do |context| %>
  <div class="col-4">
    <div class="card" style="width: 18rem;">
      <div class="card-body">
        <h5 class="card-title"><%= link_to "@" + context.name, context %></h5>
        <p class="card-text"><%= t('contexts.index.items') %>: <%= context.items.length %></p>
      </div>
    </div>
  </div>
  <% end %>
</div>



<p style="color: green"><%= notice %></p>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Overview", root_path %></li>
    <li class="breadcrumb-item"><%= link_to "Contexts", contexts_path %></li>
    <li class="breadcrumb-item active" aria-current="page">@<%= @context.name %></li>
  </ol>
</nav>

<%= render @context %>

<div class="mt-3 mb-3">
  <%= link_to "Edit this context", edit_context_path(@context), class: "btn btn-primary" %>
</div>

<div>
  <%= button_to "Delete this context", @context, method: :delete, class: "btn btn-danger" %>
</div>
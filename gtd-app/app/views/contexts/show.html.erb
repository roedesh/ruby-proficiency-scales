<p style="color: green"><%= notice %></p>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('breadcrumbs.overview'), root_path %></li>
    <li class="breadcrumb-item"><%= link_to t('contexts.index.contexts'), contexts_path %></li>
    <li class="breadcrumb-item active" aria-current="page">@<%= @context.name %></li>
  </ol>
</nav>

<%= render @context %>

<div class="mt-3 mb-3">
  <%= link_to t('contexts.show.edit_this_context'), edit_context_path(@context), class: "btn btn-primary" %>
</div>

<div>
  <%= button_to t('contexts.show.delete_this_context'), @context, method: :delete, class: "btn btn-danger" %>
</div>
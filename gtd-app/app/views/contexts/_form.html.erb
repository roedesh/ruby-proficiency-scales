<%= form_with(model: context) do |form| %>
  <% if context.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h2><%= t('contexts.form.errors_prohibited', count: context.errors.count) %></h2>

      <ul>
        <% context.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div>
    <%= form.submit t('shared.submit'), class: "btn btn-primary" %>
  </div>
<% end %>

<p style="color: green"><%= notice %></p>

<% content_for :title, t('items.index.items') %>

<h1><%= t('items.index.items') %></h1>

<%= link_to t('items.index.new_item'), new_item_path, class: "btn btn-primary" %>

<div class="card mt-4">
  <div class="card-body">
    <h5 class="card-title"><%= t('items.index.items') %></h5>
    <table class="table">
      <thead>
        <tr>
          <th scope="col"><%= t('items.index.title') %></td>
          <th scope="col"><%= t('items.index.project') %></td>
          <th scope="col"><%= t('items.index.context') %></td>
          <th scope="col"><%= t('items.index.status') %></td>
          <th scope="col"><%= t('items.index.completed_at') %></td>
          <th scope="col"><%= t('shared.actions') %></td>
        </tr>
      </thead>
      <tbody>
        <%if @items.count > 0 %>
          <% @items.each do |item| %>
            <tr>
              <td scope="row"><%= item.title %></td>
              <td><% if item.project.presence %><%= link_to item.project.name, item.project %><%else %>-<% end %></td>
              <td><% if item.context.presence %><%= link_to item.context.name, item.context %><%else %>-<% end %></td>
              <td><%= item.status %></td>
              <td><%= item.completed_at.presence || "-" %></td>
              <td><%= link_to t('shared.show'), item %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5"><%= t('items.index.no_items_yet') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>


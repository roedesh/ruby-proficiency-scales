<p style="color: green"><%= notice %></p>

<% content_for :title, "Items" %>

<h1>Items</h1>

<%= link_to "New item", new_item_path, class: "btn btn-primary" %>

<div class="card mt-4">
  <div class="card-body">
    <h5 class="card-title">Items</h5>
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Title</td>
          <th scope="col">Project</td>
          <th scope="col">Context</td>
          <th scope="col">Status</td>
          <th scope="col">Completed at</td>
          <th scope="col">Actions</td>
        </tr>
      </thead>
      <tbody>
        <%if @items.count > 0 %>
          <% @items.each do |item| %>
            <tr>
              <td scope="row"><%= item.title %></td>
              <td><% if item.project.presence %><%= link_to item.project.name, item.project %><%else %>-<% end %></td>
              <td><% if item.context.presence %><%= link_to item.context.name, item.context %><%else %>-<% end %></td>
              <td><%= item.status %></td>
              <td><%= item.completed_at.presence || "-" %></td>
              <td><%= link_to "Show", item %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5">No items yet</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>


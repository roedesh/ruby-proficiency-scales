<div id="<%= dom_id item %>">
  <div>
    <strong>User:</strong>
    <%= item.user_id %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= item.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= item.description %>
  </div>

  <div>
    <strong>Item type:</strong>
    <%= item.item_type %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= item.status %>
  </div>

  <div>
    <strong>Context:</strong>
    <%= item.context_id %>
  </div>

  <div>
    <strong>Project:</strong>
    <%= item.project_id %>
  </div>

  <div>
    <strong>Due date:</strong>
    <%= item.due_date %>
  </div>

  <div>
    <strong>Completed at:</strong>
    <%= item.completed_at %>
  </div>

  <div>
    <strong>Energy level:</strong>
    <%= item.energy_level %>
  </div>

  <div>
    <strong>Time required:</strong>
    <%= item.time_required %>
  </div>

</div>

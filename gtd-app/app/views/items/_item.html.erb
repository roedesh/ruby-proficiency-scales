<div id="<%= dom_id item %>">
  <h1>Item: <%= item.title %></h1>

  <% if item.project.present? %>
    <div>
      <strong>Project:</strong>
      <%= item.project.name %>
    </div>
  <% end %>

  <% if item.context.present? %>
    <div>
      <strong>Context:</strong>
      <%= item.context.name %>
    </div>
  <% end %>

  <div>
    <strong>Description:</strong>
    <%= item.description %>
  </div>

  <div>
    <strong>Item type:</strong>
    <%= item.item_type %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= item.status %>
  </div>

  <div>
    <strong>Context:</strong>
    <%= item.context_id %>
  </div>

  <div>
    <strong>Project:</strong>
    <%= item.project_id %>
  </div>

  <div>
    <strong>Due date:</strong>
    <%= item.due_date %>
  </div>

  <div>
    <strong>Completed at:</strong>
    <%= item.completed_at %>
  </div>

  <div>
    <strong>Energy level:</strong>
    <%= item.energy_level %>
  </div>

  <div>
    <strong>Time required:</strong>
    <%= item.time_required %>
  </div>

</div>

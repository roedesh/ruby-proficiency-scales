<div id="<%= dom_id item %>">
  <h1><%= t('items.item.item') %> <%= item.title %></h1>

  <% if item.project.present? %>
    <div>
      <strong><%= t('items.item.project') %></strong>
      <%= item.project.name %>
    </div>
  <% end %>

  <% if item.context.present? %>
    <div>
      <strong><%= t('items.item.context') %></strong>
      <%= item.context.name %>
    </div>
  <% end %>

  <div>
    <strong><%= t('items.item.description') %></strong>
    <%= item.description %>
  </div>

  <div>
    <strong><%= t('items.item.item_type') %></strong>
    <%= item.item_type %>
  </div>

  <div>
    <strong><%= t('items.item.status') %></strong>
    <%= item.status %>
  </div>

  <div>
    <strong><%= t('items.item.context') %></strong>
    <%= item.context_id %>
  </div>

  <div>
    <strong><%= t('items.item.project') %></strong>
    <%= item.project_id %>
  </div>

  <div>
    <strong><%= t('items.item.due_date') %></strong>
    <%= item.due_date %>
  </div>

  <div>
    <strong><%= t('items.item.completed_at') %></strong>
    <%= item.completed_at %>
  </div>

  <div>
    <strong><%= t('items.item.energy_level') %></strong>
    <%= item.energy_level %>
  </div>

  <div>
    <strong><%= t('items.item.time_required') %></strong>
    <%= item.time_required %>
  </div>

</div>

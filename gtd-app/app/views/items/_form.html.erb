<%= form_with(model: item) do |form| %>
  <% if item.errors.any? %>
    <div style="color: red">
      <h2><%= t('items.form.errors_prohibited', count: item.errors.count) %></h2>

      <ul>
        <% item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.textarea :description, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :item_type, class: "form-label"%>
    <%= form.select :item_type, Item::ITEM_TYPES, {}, { :class => 'form-select' } %>
  </div>

  <div class="mb-3">
    <%= form.label :status, class: "form-label" %>
    <%= form.select :status, Item::STATUSSES, {}, { :class => 'form-select' } %>
  </div>

  <div class="mb-3">
    <%= form.label :context_id %>
    <%= form.collection_select :context_id, 
        Current.user.contexts, 
        :id, 
        :name, 
        { prompt: t('items.form.select_a_context') },
        { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= form.label :project_id %>
    <%= form.collection_select :project_id, 
        Current.user.projects, 
        :id, 
        :name, 
        { prompt: t('items.form.select_a_project') },
        { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= form.label :due_date %>
    <%= form.date_field :due_date, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :completed_at %>
    <%= form.datetime_field :completed_at, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :energy_level %>
    <%= form.select :energy_level, Item::ENERGY_LEVELS, {}, { :class => 'form-select' } %>
  </div>

  <div class="mb-3">
    <%= form.label :time_required %>
    <%= form.number_field :time_required, class: 'form-select' %>
  </div>

  <div>
    <%= form.submit t('shared.submit'), class: "btn btn-primary" %>
  </div>
<% end %>

<%= form_with(model: item) do |form| %>
  <% if item.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(item.errors.count, "error") %> prohibited this item from being saved:</h2>

      <ul>
        <% item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.textarea :description %>
  </div>

  <div>
    <%= form.label :item_type, style: "display: block" %>
    <%= form.select :status, Item::ITEM_TYPES %>
  </div>

  <div>
    <%= form.label :status, style: "display: block" %>
    <%= form.select :status, Item::STATUSSES %>
  </div>

  <div>
    <%= form.label :context_id, style: "display: block" %>
    <%= form.text_field :context_id %>
  </div>

  <div>
    <%= form.label :project_id, style: "display: block" %>
    <%= form.text_field :project_id %>
  </div>

  <div>
    <%= form.label :due_date, style: "display: block" %>
    <%= form.date_field :due_date %>
  </div>

  <div>
    <%= form.label :completed_at, style: "display: block" %>
    <%= form.datetime_field :completed_at %>
  </div>

  <div>
    <%= form.label :energy_level, style: "display: block" %>
    <%= form.select :status, Item::ENERGY_LEVELS %>
  </div>

  <div>
    <%= form.label :time_required, style: "display: block" %>
    <%= form.number_field :time_required %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

<p style="color: green"><%= notice %></p>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('breadcrumbs.overview'), root_path %></li>
    <li class="breadcrumb-item"><%= link_to t('items.index.items'), items_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= @item.title %></li>
  </ol>
</nav>

<%= render @item %>

<div class="mt-3 mb-3">
  <%= link_to t('items.show.edit_this_item'), edit_item_path(@item), class: "btn btn-primary" %>
</div>

<div>
  <%= button_to t('items.show.delete_this_item'), @item, method: :delete, class: "btn btn-danger" %>
</div>
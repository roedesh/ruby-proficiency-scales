<p style="color: green"><%= notice %></p>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Overview", root_path %></li>
    <li class="breadcrumb-item"><%= link_to "Items", items_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= @item.title %></li>
  </ol>
</nav>

<%= render @item %>

<div class="mt-3 mb-3">
  <%= link_to "Edit this item", edit_item_path(@item), class: "btn btn-primary" %>
</div>

<div>
  <%= button_to "Delete this item", @item, method: :delete, class: "btn btn-danger" %>
</div>